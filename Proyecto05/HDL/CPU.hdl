CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
	
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);

    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=destA);
    Or(a=isA, b=destA, out=loadA);

    ARegister(in=aInput, load=loadA, out=aOut, out[0..14]=addressM);

    And(a=instruction[15], b=instruction[12], out=useM);
    Mux16(a=aOut, b=inM, sel=useM, out=aOrM);

    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    ALU(x=dOut, y=aOrM,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    And(a=instruction[15], b=instruction[3], out=writeM);

    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notZr, b=notNg, out=pos);

    And(a=instruction[2], b=ng,  out=jumpNeg);
    And(a=instruction[1], b=zr,  out=jumpZero);
    And(a=instruction[0], b=pos, out=jumpPos);

    Or(a=jumpNeg, b=jumpZero, out=jumpTemp);
    Or(a=jumpTemp, b=jumpPos, out=jumpCond);
    
    And(a=instruction[15], b=jumpCond, out=doJump);
    
    PC(in=aOut, load=doJump, inc=true, reset=reset, out[0..14]=pc);
}
